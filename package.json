{
  "name": "mac-core",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm --filter @monashcoding/lint build && oxlint",
    "lint:fix": "pnpm --filter @monashcoding/lint build && oxlint --fix",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@monashcoding/lint": "workspace:*",
    "@monashcoding/tsconfig": "workspace:*",
    "oxlint": "1.93.0",
    "typescript": "^7.0.2"
  }
}
